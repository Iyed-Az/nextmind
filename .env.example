SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Server-side only — used by the admin panel to bypass RLS. Keep this out of
# the client bundle and set it directly in Vercel's project env vars.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Admin panel passcode (staff login at /admin)
ADMIN_PASSCODE="set-a-strong-passcode"
# Admin session cookie secret — generate a long random string
ADMIN_SESSION_SECRET="set-a-long-random-secret-min-32-chars"
